---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Expertise from '../components/Expertise.astro';
import Skills from '../components/Skills.astro';
import Projects from '../components/Projects.astro';
import Portfolio from '../components/Portfolio.astro';
import Certifications from '../components/Certifications.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import SectionDivider from '../components/SectionDivider.astro';
import PrintResume from '../components/PrintResume.astro';
---

<Layout>
  <div
    class="web-only"
    data-retro-base={import.meta.env.BASE_URL.replace(/\/?$/, '/')}
    data-retro-count="21"
  >
  <Header />
  <main id="main-content">
    <Hero />
    <SectionDivider />
    <About />
    <SectionDivider />
    <Expertise />
    <SectionDivider />
    <Skills />
    <SectionDivider />
    <Certifications />
    <SectionDivider />
    <Portfolio />
    <SectionDivider />
    <Projects />
    <SectionDivider />
    <Contact />
  </main>
  <Footer />
  </div>
  <PrintResume />
</Layout>

<script>
  const portfolioRoot = document.querySelector<HTMLElement>('.web-only[data-retro-base]');
  const sections = [...document.querySelectorAll<HTMLElement>('.web-only main > section')];

  if (portfolioRoot && sections.length > 0) {
    const base = portfolioRoot.dataset.retroBase ?? '/';
    const count = Number(portfolioRoot.dataset.retroCount ?? 21);
    const indexes = Array.from({ length: count }, (_, index) => index + 1);

    for (let index = indexes.length - 1; index > 0; index--) {
      const swap = Math.floor(Math.random() * (index + 1));
      [indexes[index], indexes[swap]] = [indexes[swap], indexes[index]];
    }

    sections.forEach((section, index) => {
      const gif = indexes[index % indexes.length];
      section.classList.add('retro-section');
      section.style.setProperty(
        '--retro-background',
        `url("${base}images/retro-tv/bgtv_(${gif}).gif")`
      );
    });
  }
</script>
